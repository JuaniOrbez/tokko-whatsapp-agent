{
  "name": "tokko-whatsapp-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Agente que responde consultas de WhatsApp Business usando Tokko (propiedades, contactos, oportunidades) y Google Drive (archivos).",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "googleapis": "^176.0.0",
    "twilio": "^6.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
