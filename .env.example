# --- Servidor ---
PORT=3000

# --- WhatsApp vía Twilio ---
# Consola de Twilio > dashboard principal.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Con el prefijo whatsapp:, ej. "whatsapp:+14155238886" (sandbox).
TWILIO_WHATSAPP_FROM=
TWILIO_VALIDATE_SIGNATURE=true
# URL pública completa del webhook (https://tu-dominio/webhook) — la misma
# que configurás en Twilio. Necesaria para validar la firma X-Twilio-Signature.
PUBLIC_WEBHOOK_URL=
# Content Template (HX...) con un body "{{1}}" — Content Template Builder en
# Twilio. Ver docs/SETUP.md. Sin esto, el envío de texto falla.
TWILIO_CONTENT_SID=

# --- Tokko Broker API ---
# Panel Tokko > Configuración > API Key.
TOKKO_API_KEY=
TOKKO_API_BASE_URL=https://www.tokkobroker.com/api/v1
TOKKO_LANG=es_ar
# Los IDs de "opportunity_status" y de operación (venta/alquiler) ya NO se
# configuran acá — se editan desde el panel /admin (ver sección "Escalamiento
# a humano" más abajo y docs/SETUP.md). Estas variables solo sirven para
# sembrar los valores iniciales la primera vez que arranca el servidor (si
# ya las tenías cargadas de antes); después de eso, /admin manda.
TOKKO_STAGE_AUN_NO_CONTACTADOS=
TOKKO_STAGE_SIN_SEGUIMIENTO=
TOKKO_STAGE_CONTACTAR=
TOKKO_STAGE_PRIMER_CONTACTO=
TOKKO_STAGE_VOLVER_A_CONTACTAR=
TOKKO_STAGE_EVOLUCIONANDO=
TOKKO_STAGE_TOMAR_ACCION=
TOKKO_STAGE_CONGELADO=
TOKKO_STAGE_CERRADO=
TOKKO_OPERATION_ID_SALE=
TOKKO_OPERATION_ID_RENT=

# --- Google Drive (cuenta de servicio) ---
# Ruta al JSON de la cuenta de servicio (descargado de Google Cloud Console).
GOOGLE_SERVICE_ACCOUNT_FILE=./google-service-account.json
# No hace falta ningún ID de carpeta acá: alcanza con compartir la carpeta
# que quieras (con subcarpetas incluso) con el email de la cuenta de
# servicio como Editor — ver docs/SETUP.md.

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=

# --- Escalamiento a humano ---
# Igual que los IDs de Tokko de arriba: esto solo siembra el valor inicial
# la primera vez que arranca el servidor. Para cambiarlo después, usá el
# panel /admin — ahí también se explica por qué no puede ser un grupo de
# WhatsApp.
HUMAN_ESCALATION_WHATSAPP_NUMBERS=

# --- Panel de administración (/admin) ---
# Contraseña para entrar a /admin (usuario fijo "admin"). Sin esto, /admin
# devuelve 503 en vez de quedar expuesto sin protección. Elegí algo que no
# uses en otro lado.
ADMIN_PASSWORD=
