# --- Servidor ---
PORT=3000

# --- WhatsApp Cloud API (Meta for Developers) ---
# App > WhatsApp > API Setup. El número de teléfono debe estar verificado.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Token que vos elegís y pegás también en la config del Webhook en Meta.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v21.0
# Opcional: valida la firma X-Hub-Signature-256 del webhook (App Secret de Meta).
WHATSAPP_APP_SECRET=

# --- Tokko Broker API ---
# Panel Tokko > Configuración > API Key.
TOKKO_API_KEY=
TOKKO_API_BASE_URL=https://www.tokkobroker.com/api/v1
TOKKO_LANG=es_ar
# IDs reales de tu workflow de oportunidades en Tokko (ver docs/SETUP.md).
TOKKO_STAGE_NEW=
TOKKO_STAGE_CONTACTED=
TOKKO_STAGE_QUALIFIED=
TOKKO_STAGE_VISIT_SCHEDULED=
TOKKO_STAGE_NEGOTIATION=
TOKKO_STAGE_WON=
TOKKO_STAGE_LOST=
# IDs de operación (venta/alquiler) en tu cuenta (ver docs/SETUP.md).
TOKKO_OPERATION_ID_SALE=
TOKKO_OPERATION_ID_RENT=

# --- Google Drive (cuenta de servicio) ---
# Ruta al JSON de la cuenta de servicio (descargado de Google Cloud Console).
GOOGLE_SERVICE_ACCOUNT_FILE=./google-service-account.json
# Carpeta compartida con la cuenta de servicio como "Lector".
GOOGLE_DRIVE_FOLDER_ID=

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=
